<?xml version="1.0" encoding="utf-8"?>
<!--
  单个实例的设置表单：资源限制 + 镜像 + 换源。

  用 ScrollView 包住：小屏设备上五组输入框 + 换源区会超出屏幕高度，
  不滚动的话「保存」按钮点不到。这也是把它做成对话框而非独立页的原因——
  实例设置是「改完就走」的轻量操作，不值得占用一个导航页。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ==================== 资源限制 ==================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/limits_title"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/limits_subtitle"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- 预设下拉：点开弹单选，避免用户手填出会让 shell 起不来的极端值 -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_limits_preset"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/limits_preset" />

        <EditText
            android:id="@+id/edit_limit_memory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/limits_memory"
            android:inputType="number"
            android:maxLength="6"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/limits_memory_hint"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary" />

        <EditText
            android:id="@+id/edit_limit_processes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/limits_processes"
            android:inputType="number"
            android:maxLength="6"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/edit_limit_open_files"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/limits_open_files"
            android:inputType="number"
            android:maxLength="7"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/edit_limit_cpu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/limits_cpu"
            android:inputType="number"
            android:maxLength="7"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/limits_cpu_hint"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary" />

        <EditText
            android:id="@+id/edit_limit_stack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/limits_stack"
            android:inputType="number"
            android:maxLength="5"
            android:importantForAutofill="no" />

        <!-- ==================== 镜像 ==================== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/mirror_title"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_mirror_auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/mirror_auto" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mirror_auto_hint"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary" />

        <EditText
            android:id="@+id/edit_mirror_custom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/mirror_custom"
            android:inputType="textUri"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mirror_custom_hint"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_mirror_speedtest"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/mirror_speedtest" />

        <TextView
            android:id="@+id/tv_mirror_probe_result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            android:visibility="gone"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- 线程数用纯数字输入，范围校验在代码里做（1~8） -->
        <EditText
            android:id="@+id/edit_download_threads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/mirror_threads"
            android:inputType="number"
            android:maxLength="1"
            android:importantForAutofill="no" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/mirror_threads_hint"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary" />

        <!-- ==================== 换源 ==================== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="?android:attr/listDivider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/apt_title"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary" />

        <TextView
            android:id="@+id/tv_apt_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorPrimary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apt_switch"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/apt_switch" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_apt_restore"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/apt_restore" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="8dp"
            android:text="@string/apt_subtitle"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>
</ScrollView>
