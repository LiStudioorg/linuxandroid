<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_page"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- 顶部：圆角搜索框（搜索终端输出，不发给 shell） -->
    <EditText
        android:id="@+id/edit_search"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:background="@drawable/bg_search"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="8dp"
        android:fontFamily="sans"
        android:hint="@string/search_hint"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:textSize="14sp" />

    <!-- 纯黑终端输出区（Termux 风格） -->
    <ScrollView
        android:id="@+id/scroll_output"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_terminal"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <TextView
            android:id="@+id/tv_output"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:lineSpacingExtra="2dp"
            android:padding="12dp"
            android:text="@string/terminal_empty"
            android:textColor="@color/terminal_text"
            android:textIsSelectable="true"
            android:textSize="13sp" />
    </ScrollView>

    <!--
      快捷键第 1 行：ESC / CTRL / ALT / TAB / 回车 / 符号
      发的都是真实控制序列：ESC=\x1b、TAB=\x09、回车=\n、|=0x7C、/=0x2F，
      CTRL/ALT 是「待命修饰键」，按下后展开字母行。
    -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_esc"
                style="@style/App.Key"
                android:text="@string/hotkey_esc" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_ctrl"
                style="@style/App.Key"
                android:layout_marginStart="6dp"
                android:text="@string/hotkey_ctrl" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_alt"
                style="@style/App.Key"
                android:layout_marginStart="6dp"
                android:text="@string/hotkey_alt" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_tab"
                style="@style/App.Key"
                android:layout_marginStart="6dp"
                android:text="@string/hotkey_tab" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_enter"
                style="@style/App.Key"
                android:layout_marginStart="6dp"
                android:text="@string/hotkey_enter" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_pipe"
                style="@style/App.Key"
                android:layout_marginStart="6dp"
                android:text="@string/hotkey_pipe" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_slash"
                style="@style/App.Key"
                android:layout_marginStart="6dp"
                android:text="@string/hotkey_slash" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_home"
                style="@style/App.Key"
                android:layout_marginStart="6dp"
                android:text="@string/hotkey_home" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_end"
                style="@style/App.Key"
                android:layout_marginStart="6dp"
                android:text="@string/hotkey_end" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_pgup"
                style="@style/App.Key"
                android:layout_marginStart="6dp"
                android:text="@string/hotkey_pgup" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_pgdn"
                style="@style/App.Key"
                android:layout_marginStart="6dp"
                android:text="@string/hotkey_pgdn" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- 快捷键第 2 行：方向键（单独一行，避免第 1 行横滚太长） -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_up"
                style="@style/App.Key"
                android:text="@string/hotkey_up" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_down"
                style="@style/App.Key"
                android:layout_marginStart="6dp"
                android:text="@string/hotkey_down" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_left"
                style="@style/App.Key"
                android:layout_marginStart="6dp"
                android:text="@string/hotkey_left" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_key_right"
                style="@style/App.Key"
                android:layout_marginStart="6dp"
                android:text="@string/hotkey_right" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- CTRL / ALT 组合字母行：仅在对应修饰键待命时可见 -->
    <HorizontalScrollView
        android:id="@+id/scroll_ctrl_letters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/group_ctrl_letters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- 底部：命令输入 + 发送 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!--
          style="@style/App.TerminalInput" 是避开国产 ROM 安全键盘的关键，
          详见 themes.xml 中该样式的注释。
        -->
        <EditText
            android:id="@+id/edit_command"
            style="@style/App.TerminalInput"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search"
            android:hint="@string/hint_command"
            android:importantForAutofill="no"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_send"
            style="@style/App.Button"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:minWidth="84dp"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/btn_send" />
    </LinearLayout>
</LinearLayout>
