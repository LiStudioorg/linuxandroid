<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全局浅色 Material 主题 -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_dark</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorSecondary">@color/accent_pink</item>
        <item name="colorSecondaryVariant">@color/accent_pink_pressed</item>
        <item name="colorAccent">@color/accent_pink</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorOnSecondary">#FF2B2B2B</item>
        <item name="colorSurface">#FFFFFFFF</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- 圆角实心按钮 -->
    <style name="App.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/accent_pink</item>
        <item name="android:textColor">#FF2B2B2B</item>
    </style>

    <!-- 终端快捷键小按钮 -->
    <style name="App.Key" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/divider</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>
</resources>
