<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 全局浅色 Material 主题 -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/color_primary</item>
        <item name="colorPrimaryVariant">@color/color_primary_dark</item>
        <item name="colorPrimaryDark">@color/color_primary_dark</item>
        <item name="colorSecondary">@color/accent_pink</item>
        <item name="colorSecondaryVariant">@color/accent_pink_pressed</item>
        <item name="colorAccent">@color/accent_pink</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="colorOnSecondary">#FF2B2B2B</item>
        <item name="colorSurface">#FFFFFFFF</item>
        <item name="android:windowBackground">@color/bg_page</item>
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FFFFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- 圆角实心按钮 -->
    <style name="App.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">20dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/accent_pink</item>
        <item name="android:textColor">#FF2B2B2B</item>
    </style>

    <!-- 终端快捷键小按钮 -->
    <style name="App.Key" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">8dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/divider</item>
        <item name="android:insetTop">2dp</item>
        <item name="android:insetBottom">2dp</item>
    </style>

    <!--
      终端命令输入框样式。**不是普通文本输入框**，需同时满足 4 个条件
      才能避开国产 ROM 的「安全键盘」：

        1. inputType 为 textVisiblePassword（TYPE_TEXT_VARIATION_VISIBLE_PASSWORD）：
           这是唯一能同时保持 (a) 不进入密码安全键盘 且 (b) 支持多字符输入的
           变体。textPassword / textWebPassword 会强制触发安全键盘。
        2. imeOptions 不是 actionSend/actionSearch 等「动作」类型：安全键盘的
           触发判定也看 imeOptions，用 IME_ACTION_NONE 最稳。
        3. 声明 imeHintLocales（由代码按需设置）不属于安全键盘场景。
        4. 代码侧把 importantForAutofill 设为 no 且禁用自动纠错/联想，
           避免输入法把它当作用户名/密码框。

      禁用联想完全由 inputType 里的 textNoSuggestions 标志承担。
       ⚠️ 不要写 android:autoCorrect —— 它不是框架属性（只是 IDE 建议），
       android.jar 中不存在，写进 style 会导致 AAPT 链接失败：
       error: style attribute 'android:attr/autoCorrect' not found。
    -->
    <style name="App.TerminalInput" parent="Widget.AppCompat.EditText">
        <item name="android:inputType">textVisiblePassword|textNoSuggestions|textMultiLine</item>
        <item name="android:imeOptions">actionNone|flagNoExtractUi|flagNoFullscreen</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>
</resources>
